<Window x:Class="Sz3d.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf"
        xmlns:controls="clr-namespace:Sz3d.App.Controls"
        xmlns:vm="clr-namespace:Sz3d.App.ViewModels"
        xmlns:core="clr-namespace:Sz3d.Core.Nodes;assembly=Sz3d.Core"
        Title="Sz3D · 3D 视觉节点式编程平台" Height="820" Width="1360"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        PreviewKeyDown="OnPreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ 工具栏 ============ -->
        <Border Grid.Row="0" Background="{StaticResource PanelHeader}" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel>
                <TextBlock Text="Sz3D" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="▶ 运行" Style="{StaticResource AccentButton}" Command="{Binding RunCommand}" Margin="0,0,6,0"/>
                    <Button Content="加载示例" Command="{Binding LoadSampleCommand}" Margin="0,0,6,0"/>
                    <Button Content="清空" Command="{Binding ClearCommand}" Margin="0,0,6,0"/>
                    <Button Content="删除选中" Command="{Binding DeleteSelectionCommand}" Margin="0,0,6,0"/>
                    <Button Content="关于" Click="OnAbout" Margin="0,0,6,0"/>
                </StackPanel>
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                           DockPanel.Dock="Right" Margin="8,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- ============ 主区域 ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：节点库 -->
            <Border Grid.Column="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock Text="节点库" Style="{StaticResource PanelHeaderText}" DockPanel.Dock="Top"/>
                    <TextBlock Text="拖拽算子到画布，连线构建项目流程" Style="{StaticResource MutedText}" DockPanel.Dock="Bottom" Margin="10,0,10,10" TextWrapping="Wrap"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Library}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LibraryCategoryViewModel}">
                                    <StackPanel>
                                        <Border Background="{StaticResource PanelHeader}" Padding="10,4" Margin="0,4,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="8" Height="8" RadiusX="4" RadiusY="4" VerticalAlignment="Center" Margin="0,0,6,0"
                                                           Fill="{Binding Name, Converter={StaticResource CategoryBrush}}"/>
                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                                            </StackPanel>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Items}" Margin="0,2,0,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type core:NodeDescriptor}">
                                                    <Border Padding="16,5" Cursor="Hand"
                                                            PreviewMouseLeftButtonDown="OnLibraryItemMouseDown">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#FF333338"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Border.ToolTip>
                                                            <StackPanel MaxWidth="240">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                            </StackPanel>
                                                        </Border.ToolTip>
                                                        <TextBlock Text="{Binding Title}" FontSize="12"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource SeparatorBrush}"/>

            <!-- 中间：画布 + 底部输出 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="260"/>
                </Grid.RowDefinitions>

                <controls:GraphCanvasView Grid.Row="0"/>

                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="{StaticResource SeparatorBrush}"/>

                <TabControl Grid.Row="2" Background="{StaticResource PanelBackground}">
                    <!-- 2D 视图 -->
                    <TabItem Header="2D 视图">
                        <Grid Background="{StaticResource WindowBackground}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding ImageInfo}" Style="{StaticResource MutedText}" Margin="10,6"/>
                            <Border Grid.Row="1" Margin="6" Background="#FF151515" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <Grid>
                                        <Image Source="{Binding ImageResult}" Stretch="Uniform" Margin="8"
                                               Visibility="{Binding ImageResult, Converter={StaticResource NullToVisibility}}"/>
                                        <TextBlock Text="（无图像数据，请运行含图像输出的节点）" Foreground="{StaticResource TextSecondary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding ImageResult, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}"/>
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- 3D 视图 -->
                    <TabItem Header="3D 视图">
                        <Grid Background="{StaticResource WindowBackground}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="10,4">
                                <TextBlock Text="{Binding CloudInfo}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                <Button Content="适配视图" DockPanel.Dock="Right" Click="OnFitView"/>
                            </DockPanel>
                            <hx:HelixViewport3D x:Name="Viewport3D" Grid.Row="1" Margin="4"
                                                Background="#FF151515"
                                                ShowCoordinateSystem="True" ShowViewCube="False">
                                <hx:GridLinesVisual3D Length="300" Width="300" MinorDistance="10" MajorDistance="50" Thickness="0.4"/>
                            </hx:HelixViewport3D>
                        </Grid>
                    </TabItem>

                    <!-- 日志 -->
                    <TabItem Header="日志">
                        <ListBox ItemsSource="{Binding Log}" Background="{StaticResource WindowBackground}"
                                 BorderThickness="0" Foreground="{StaticResource TextPrimary}"
                                 FontFamily="Consolas" FontSize="12" Padding="6"/>
                    </TabItem>
                </TabControl>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource SeparatorBrush}"/>

            <!-- 右侧：属性面板 -->
            <Border Grid.Column="4" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <TextBlock Text="属性" Style="{StaticResource PanelHeaderText}" DockPanel.Dock="Top"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 未选中 -->
                            <TextBlock Text="未选中节点" Style="{StaticResource MutedText}" Margin="12,10"
                                       Visibility="{Binding SelectedNode, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}"/>

                            <!-- 节点信息 -->
                            <StackPanel Visibility="{Binding SelectedNode, Converter={StaticResource NullToVisibility}}">
                                <Border Background="{StaticResource PanelHeader}" Padding="10,8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedNode.Title}" FontSize="15" FontWeight="SemiBold"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Rectangle Width="10" Height="10" RadiusX="5" RadiusY="5" VerticalAlignment="Center" Margin="0,0,6,0"
                                                       Fill="{Binding SelectedNode.Category, Converter={StaticResource CategoryBrush}}"/>
                                            <TextBlock Text="{Binding SelectedNode.Category}" Style="{StaticResource MutedText}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding SelectedNode.Description}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="输入参数" Style="{StaticResource PanelHeaderText}"/>
                                <ItemsControl ItemsSource="{Binding SelectedNode.Inputs}" Margin="4,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PortViewModel}">
                                            <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                 Fill="{Binding DataType, Converter={StaticResource DataTypeBrush}}"/>
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12"/>
                                                    </StackPanel>
                                                    <!-- 可编辑参数 -->
                                                    <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
                                                             Visibility="{Binding ShowTextBox, Converter={StaticResource BoolToVisibility}}"/>
                                                    <CheckBox Grid.Column="1" Content="" IsChecked="{Binding BoolValue}" VerticalAlignment="Center"
                                                              Visibility="{Binding ShowCheckBox, Converter={StaticResource BoolToVisibility}}"/>
                                                    <!-- 已连接 -->
                                                    <TextBlock Grid.Column="1" Text="已连接" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                                               Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="输出" Style="{StaticResource PanelHeaderText}"/>
                                <ItemsControl ItemsSource="{Binding SelectedNode.Outputs}" Margin="4,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PortViewModel}">
                                            <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                 Fill="{Binding DataType, Converter={StaticResource DataTypeBrush}}"/>
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding ValueText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
